<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <AssemblyName>OmniQL</AssemblyName>
    <RootNamespace>OmniQL</RootNamespace>
    <Version>0.6.2</Version>
    <Authors>Uttam Mahata</Authors>
    <Description>A standardized, multi-database query language (OQL) for .NET.</Description>
    <PackageProjectUrl>https://github.com/Uttam-Mahata/omniql</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Uttam-Mahata/omniql</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include native libraries in the NuGet package using forward slashes for cross-platform compatibility -->
    <None Include="runtimes/linux-x64/native/libomniql.so" Pack="true" PackagePath="runtimes/linux-x64/native" />
    <None Include="runtimes/osx-x64/native/libomniql.dylib" Pack="true" PackagePath="runtimes/osx-x64/native" />
    <None Include="runtimes/win-x64/native/omniql.dll" Pack="true" PackagePath="runtimes/win-x64/native" />
  </ItemGroup>

</Project>
